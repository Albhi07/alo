{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "paths": {
      "npm:@anthropic-ai/sdk@1.14.0": ["./node_modules/@anthropic-ai/sdk"],
      "npm:@supabase/supabase-js@2.45.4": ["./node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["supabase/functions/deno-shim.d.ts", "supabase/functions/_shared", "supabase/functions/tutor"]
}
